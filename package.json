{
  "name": "scratchjr",
  "version": "1.2.0",
  "description": "ScratchJr",
  "scripts": {
    "lint": "eslint src/**",
    "watch": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack --mode=development --progress --hide-modules --watch",
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack --mode=development --progress --hide-modules",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack --mode=production --progress --hide-modules",
    "sync:ai": "node scripts/sync-ai-vendor.js",
    "icons:pwa": "node scripts/generate-pwa-icons.js",
    "precache": "node scripts/generate-precache.js",
    "verify:pwa": "node scripts/verify-pwa.js",
    "verify:ui": "node scripts/verify-ui-layout.js",
    "test:pwa": "npm run build:web && npm run verify:pwa && npm run verify:ui",
    "package:pwa": "node scripts/package-pwa.js",
    "release:pwa": "npm run test:pwa && npm run package:pwa",
    "build:web": "npm run sync:ai && npm run icons:pwa && node scripts/build-web.js",
    "serve": "node scripts/serve.js",
    "deploy": "npx wrangler deploy",
    "preview": "npx wrangler dev"
  },
  "author": "Massachusetts Institute of Technology",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/llk/scratchjr/issues"
  },
  "homepage": "https://github.com/llk/scratchjr",
  "devDependencies": {
    "@babel/polyfill": "^7.10.4",
    "babel-core": "^6.4.0",
    "babel-eslint": "^4.1.6",
    "babel-loader": "^7.1.4",
    "babel-preset-es2015": "^6.3.13",
    "babel-preset-stage-3": "^6.24.1",
    "cross-env": "^7.0.3",
    "esformatter": "^0.8.1",
    "esformatter-braces": "^1.2.1",
    "esformatter-dot-notation": "^1.3.1",
    "esformatter-quotes": "^1.0.3",
    "esformatter-semicolons": "^1.1.2",
    "eslint": "^1.10.3",
    "expose-loader": "^0.7.1",
    "playwright": "^1.63.0",
    "sharp": "^0.33.5",
    "strip-sourcemap-loader": "0.0.1",
    "svgo": "^3.3.2",
    "webpack": "^4.18.0",
    "webpack-cli": "^3.1.0",
    "webpack-notifier": "^1.6.0",
    "wrangler": "^4.112.0"
  },
  "dependencies": {
    "@mediapipe/hands": "^0.4.1675469240",
    "intl": "^1.0.1",
    "intl-messageformat": "^1.2.0",
    "jszip": "^3.10.1",
    "snapsvg": "^0.3.0"
  }
}
